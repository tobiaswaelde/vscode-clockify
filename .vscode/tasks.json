{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "yarn: watch",
			"type": "shell",
			"command": "yarn watch",
			"problemMatcher": "$ts-webpack-watch",
			"isBackground": true,
			"presentation": {
				"reveal": "never",
				"group": "watchers"
			},
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "yarn: test",
			"type": "shell",
			"command": "yarn test",
			"problemMatcher": [],
			"group": "test"
		}
	]
}
